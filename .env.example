# PostgreSQL (usado pelo compose.yml para subir o container local)
POSTGRES_DB=secondbrain
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=secondbrain_dev

# Connection string da API (sobrescreve appsettings.json via variável de ambiente
# padrão do ASP.NET Core — ConnectionStrings__DefaultConnection).
# Em dev local, appsettings.Development.json já aponta pro Postgres acima; use
# esta variável apenas em outros ambientes (staging/produção) ou para customizar.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=secondbrain;Username=secondbrain;Password=secondbrain_dev
